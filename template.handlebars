<html>
  <head>
    <meta content="text/html; charset=utf-8" http-equiv="Content-Type" />
    {{css "fonts.css"}}
    {{css "semantics.css"}}
    {{css "tabular.css"}}
    <link
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
    />
  </head>
  <body onload="javascript:main()">
    <main class="page">

      <!-- ============================================================
         HEADER
         ============================================================ -->

      <header id="header">

        <h1 id="fullname">{{resume.basics.name}}</h1>

        {{#with resume.basics}}
          <div id="contact">

            {{#if email}}
              <a href="mailto:{{email}}">
                <i class="fa fa-at"></i>
                {{email}}
              </a>
            {{/if}}

            {{#if phone}}
              <a href="tel:{{phone}}">
                <i class="fa fa-phone"></i>
                {{phone}}
              </a>
            {{/if}}

            {{#each profiles}}
              <a href="{{url}}">
                <i class="fa fa-{{toLowerCase this.network}}"></i>
                {{network}}/{{username}}
              </a>
            {{/each}}

            {{#if location}}
              <span>
                <i class="fa fa-map-marker"></i>
                {{location.city}}{{#if location.countryCode}},
                  {{location.countryCode}}{{/if}}
              </span>
            {{/if}}

          </div>
        {{/with}}
        {{#if resume.basics.summary}}
          <p id="summary">
            {{resume.basics.summary}}
          </p>
        {{/if}}

      </header>

      <!-- ============================================================
         MAIN CONTENT
         ============================================================ -->

      <div id="main-content">

        <!-- ==================== EDUCATION ==================== -->

        {{#if resume.education}}
          <section id="education">

            <h2>Academic Experience</h2>

            {{#each resume.education}}
              <div class="entry">

                <div class="date">
                  {{startDate}}<br />
                  <span class="date-separator">–</span><br />
                  {{endDate}}
                </div>

                <div class="entry-content">

                  <div class="entry-header">
                    <h3>{{institution}}</h3>
                  </div>

                  <p class="entry-title">
                    {{studyType}}
                    {{area}}
                  </p>

                  {{#if special_courses}}
                    <ul>
                      {{#each special_courses}}
                        <li />{{this}}
                      {{/each}}

                      {{#if score}}
                        <li>
                          {{score}}
                          average grade
                          {{#if ranking}}({{ranking}}){{/if}}
                        </li>
                      {{/if}}
                    </ul>
                  {{/if}}

                  {{#if courses}}
                    <p class="subheading">Relevant coursework</p>

                    <ul>
                      {{#each this.highlights}}
                        <li />{{this}}
                      {{/each}}

                      {{#if score}}
                        <li>
                          {{score}}
                          average grade
                          {{#if ranking}}({{ranking}}){{/if}}
                        </li>
                      {{/if}}
                    </ul>
                  {{/if}}

                  {{#if score}}
                    {{#unless special_courses}}
                      {{#unless courses}}
                        <p class="entry-detail">
                          {{score}}
                          average grade
                          {{#if ranking}}({{ranking}}){{/if}}
                        </p>
                      {{/unless}}
                    {{/unless}}
                  {{/if}}

                </div>

              </div>
            {{/each}}

          </section>
        {{/if}}

        <!-- ==================== WORK EXPERIENCE ==================== -->

        {{#if resume.work}}
          <section id="work-experience">

            <h2>Work Experience</h2>

            {{#each resume.work}}
              <div class="entry">

                <div class="date">
                  {{startDate}}<br />
                  <span class="date-separator">–</span><br />
                  {{endDate}}
                </div>

                <div class="entry-content">

                  <h3>{{name}}</h3>

                  <p class="entry-title">
                    {{position}}
                  </p>

                  {{#if summary}}
                    <p class="summary">
                      {{summary}}
                    </p>
                  {{/if}}

                  {{#if highlights}}
                    <ul>
                      {{#each highlights}}
                        <li>{{this}}</li>
                      {{/each}}
                    </ul>
                  {{/if}}

                  {{#if technologies}}
                    <div class="tags">
                      {{#each technologies}}
                        <span class="tag">{{this}}</span>
                      {{/each}}
                    </div>
                  {{/if}}

                </div>

              </div>
            {{/each}}

          </section>
        {{/if}}

        <!-- ==================== PROJECTS ==================== -->

        {{#if resume.projects}}
          <section id="projects">

            <h2>Selected Projects</h2>

            {{#each resume.projects}}
              <div class="entry">

                <div class="date">
                  {{#if date}}
                    {{date}}
                  {{else}}
                    {{startDate}}
                    {{#if endDate}}
                      <br />
                      <span class="date-separator">–</span>
                      <br />
                      {{endDate}}
                    {{/if}}
                  {{/if}}
                </div>

                <div class="entry-content">

                  <h3>
                    {{#if url}}<a href="{{url}}">{{this.name}}</a>
                    {{else}}{{this.name}}
                    {{/if}}
                  </h3>

                  {{#if generic}}
                    <p class="entry-title">
                      {{generic}}
                    </p>
                  {{/if}}

                  {{#if summary}}
                    <p class="summary">
                      {{summary}}
                    </p>
                  {{/if}}

                  {{#if highlights}}
                    <ul>
                      {{#each highlights}}
                        <li>{{this}}</li>
                      {{/each}}
                    </ul>
                  {{/if}}

                  {{#if keywords}}
                    <div class="tags">
                      {{#each keywords}}
                        <span class="tag">{{this}}</span>
                      {{/each}}
                    </div>
                  {{/if}}

                </div>

              </div>
            {{/each}}

          </section>
        {{/if}}

        <!-- ==================== AWARDS ==================== -->

        {{#if resume.awards}}
          <section id="achievements">

            <h2>Achievements</h2>

            {{#each resume.awards}}
              <div class="entry">

                <div class="date">
                  {{date}}
                </div>

                <div class="entry-content">

                  <h3>{{title}}</h3>

                  <p class="entry-title">
                    {{awarder}}
                  </p>

                  {{#if summary}}
                    <p class="summary">
                      {{summary}}
                    </p>
                  {{/if}}

                </div>

              </div>
            {{/each}}

          </section>
        {{/if}}

        <!-- ==================== SKILLS ==================== -->

        {{#if resume.skills}}
          <section id="skills">

            <h2>Skills</h2>

            <div id="skills-grid">

              {{#each resume.skills}}
                <div class="skill-group">

                  <h3>{{name}}</h3>

                  {{#if keywords}}
                    <ul>
                      {{#each keywords}}
                        <li>{{this}}</li>
                      {{/each}}
                    </ul>
                  {{/if}}

                </div>
              {{/each}}

              {{#if resume.languages}}
                <div class="skill-group" id="spoken-languages">

                  <h3>Spoken Languages</h3>

                  <ul>
                    {{#each resume.languages}}
                      <li>
                        <span>{{language}}</span>
                        <span class="fluency">{{fluency}}</span>
                      </li>
                    {{/each}}
                  </ul>

                </div>
              {{/if}}

            </div>

          </section>
        {{/if}}

      </div>
    </main>
  </body>
</html>