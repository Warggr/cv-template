<!DOCTYPE html>
<html>
<head>
	<meta content="text/html; charset=utf-8" http-equiv="Content-Type"/>
    {{css "fonts.css"}}
	{{css "semantics.css"}}
	{{css "columns.css"}}
	{{css "style.css"}}
	{{css "editor.css"}}
	<link href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css'/>
	<script src="editor.js"></script>
</head>
<body onload="javascript:main()">
	<main class="page">
	<div class="column" id="col-left">
        {{#with resume.basics}}
        {{#if image}}
        <img src="{{image}}" id="img_profile" class="big"/>
        {{/if}}
        <div id="facts">
			<div>
				<i class="fa fa-at"></i>
                <span><a href="mailto:{{email}}" style="font-size: 80%">{{email}}</a></span>
			</div>
			<div>
				<i class="fa fa-phone"></i>
                <span><a href="callto:{{phone}}">{{phone}}</a></span>
			</div>
            {{#each profiles}}
			<div>
                <i class="fa fa-{{toLowerCase this.network}}"></i>
                <span><a href="{{url}}">{{network}}/{{username}}
				</a></span>
			</div>
            {{/each}}
            {{#if location}}{{#with location}}
			<div>
				<i class="fa fa-envelope-o"></i>
                <span>{{address}}<br/>{{postalCode}} {{city}}<br/>{{region}}-{{countryCode}}</span>
			</div>
            {{/with}}{{/if}}
            {{#if birth}}
			<div>
				<i class='fa fa-asterisk'></i>
                <span>born {{birth.date}}
                    {{#if birth.place}}in {{birth.place}}{{/if}}</span>
			</div>
            {{/if}}
		</div>
        {{/with}}
		<section id="skills">
            {{#if resume.lectures}}
            <h2>Relevant lectures</h2>
            <ul id="lectures" class="skillList">
            {{#each resume.lectures}}
                <li>{{this}}</li>
            {{/each}}{{/if}}
            </ul>
            {{#if resume.skills}}
			<h2>Skills</h2>
            {{#each resume.skills}}
			<section>
                <h3>{{this.name}}</h3>
                {{#if this.keywords}}
				<ul class="skillList">
                    {{#each this.keywords}}
                    <li>{{this}}</li>
                    {{/each}}
				</ul>
                {{/if}}
			</section>
            {{/each}}{{/if}}
            {{#if resume.languages}}
			<section id="spoken-languages">
				<h3>Spoken Languages</h3>
				<table>
                    {{#each resume.languages}}
					<tr>
                        <td>{{this.language}}</td><td>{{this.fluency}}</td>
					</tr>
                    {{/each}}
				</table>
			</section>
            {{/if}}
		</section>
        {{#if resume.interests}}
		<section id="hobbies">
			<h2>Other interests / hobbies</h2>
			<ul>
                {{#each resume.interests}}
                <li/><b>{{this.name}}</b>
                    {{#if this.keywords}}{{#each this.keywords}}
                    <span class="skill">{{this}}</span>
                    {{/each}}{{/if}}
                {{/each}}
			</ul>
		</section>
        {{/if}}
	</div>
	<div class="column" id="col-right">
		<p id="fullname">{{resume.basics.name}}</p>
        {{#if resume.basics.summary}}
		<section id="about">
            <p>{{resume.basics.summary}}</p>
		</section>
        {{/if}}
		<div id="main-content">
            {{#if resume.education}}
			<section class="main-content" id="academic-xp">
				<h2>Academic Experience</h2>
                {{#each resume.education}}
				<div>
                    <h4>{{this.institution}}</h4>
                    <span class="time">{{this.startDate}} - {{this.endDate}}</span>
                    <h3>{{this.studyType}} {{this.area}}</h3>
                    {{#if this.special_courses}}
                    <ul>
                    {{#each special_courses}}
                        <li/>{{this}}
                    {{/each}}
                    {{#if courses}}
                    <li/>Relevant lectures:
                    {{/if}}
                    {{/if}}
                    {{#if this.courses}}
					<ul>
                        {{#each this.courses}}
                        <li/>{{this}}
                        {{/each}}
                        {{#if this.score}}<li/>{{this.score}} average grade{{/if}}
					</ul>
                    {{/if}}
                    {{#if this.special_courses}}
                    </ul>
                    {{/if}}
				</div>
                {{/each}}
			</section>
            {{/if}}
            {{#if resume.work}}
			<section class="main-content" id="work-xp">
				<h2>Work Experience</h2>
                {{#each resume.work}}
				<div>
                    <span class="time">{{this.startDate}} &ndash; {{this.endDate}}</span>
                    <h4>{{this.name}}</h4>
                    <h3>{{this.position}}</h3>
                    {{#if this.summary}}<p>{{this.summary}}</p>{{/if}}
                    {{#if this.highlights}}
					<ul>
                        {{#each this.highlights}}
                        <li/>{{this}}
                        {{/each}}
					</ul>
                    {{/if}}
                    {{#if this.technologies}}{{#each this.technologies}}
                    <span class="skill">{{this}}</span>
                    {{/each}}{{/if}}
				</div>
                {{/each}}
			</section>
            {{/if}}
            {{#if resume.volunteer}}
			<section class="main-content" id="volunteering-xp">
				<h2>Volunteering Experience</h2>
                {{#each resume.volunteer}}
				<div>
                    <h4>{{this.organization}}</h4>
                    <span class="time">{{this.startDate}} - {{this.endDate}}</span>
                    <h3>{{this.position}}</h3>
                    <p>{{this.summary}}</p>
                    {{#if this.technologies}}{{#each this.technologies}}
                    <span class="skill">{{this}}</span>
                    {{/each}}{{/if}}
				</div>
                {{/each}}
			</section>
            {{/if}}
            {{#if resume.awards}}
			<section class="main-content" id="achievements">
				<h2>Achievements</h2>
                {{#each resume.awards}}
				<div>
                    <h4>{{this.awarder}}</h4>
                    <span class="time">{{this.date}}</span>
                    <h3>{{this.title}}</h3>
                    <p>{{this.description}}</p>
				</div>
                {{/each}}
			</section>
            {{/if}}
            {{#if resume.projects}}
			<section class="main-content" id="personal-projects" class="big">
				<h2>Personal / hobby projects</h2>
                {{#each resume.projects}}
				<div>
                    <h3>
                        {{#if url}}<a href="{{url}}">{{this.name}}</a>
                        {{else}}{{this.name}}
                        {{/if}}
                    </h3>
                    <span class="time">{{this.startDate}} - {{this.endDate}}</span>
                    <p>{{this.description}}</p>
                    {{#if this.keywords}}{{#each this.keywords}}
                    <span class="skill">{{this}}</span>
                    {{/each}}{{/if}}
				</div>
                {{/each}}
			</section>
            {{/if}}
		</div>
	</div>
	</main>
</body>
</html>
